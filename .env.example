# Minds Builder Hub 生成的服务端密钥。不要提交真实值。
MINDS_BUILDER_API_KEY=

# 可选。账号内有多个 Mind 时指定核心 Mind ID。
MINDS_MIND_ID=

# 可选。默认 creator-main。
MINDS_CONVERSATION_ALIAS=creator-main

# 可选。默认 data/creator-mind.sqlite。
CREATOR_MIND_DATABASE_PATH=

# 可选。多个 RSS 用逗号分隔，每项格式为“来源名|https://example.com/feed.xml”。
CREATOR_MIND_RSS_FEEDS=

# 可选。仅用于 X API v2 官方 recent search，不使用网页抓取。
X_BEARER_TOKEN=
X_SEARCH_QUERY=AI -is:retweet

# Horizon 后台 Worker。服务商必填后，其余选项可保留默认值。
HORIZON_ENABLED=true
HORIZON_PROVIDER=deepseek
HORIZON_API_KEY=
HORIZON_BASE_URL=
HORIZON_AZURE_ENDPOINT=
HORIZON_HOURS=24
HORIZON_THRESHOLD=7
HORIZON_HACKER_NEWS=true
HORIZON_OSS_INSIGHT=false
HORIZON_ENRICH=true

# 生产环境必填。托管 cron 或 Mind App 调用 /api/agent/* 时使用 Bearer 认证。
CREATOR_MIND_CRON_SECRET=
