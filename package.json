    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "twitter-api-v2": "^1.29.1",
    "undici": "^8.10.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
